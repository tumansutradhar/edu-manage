# =========================================================================
# FRONTEND ENVIRONMENT VARIABLES CONFIGURATION (EXAMPLE)
# Copy this file to a new file named '.env' and update the values below.
# NOTE: All variables MUST begin with 'REACT_APP_' to be recognized by CRA.
# =========================================================================

# The API Endpoint linking your React frontend to your Express backend
# Local Testing: Use http://localhost:5000
# Production: Change this to your hosted backend URL (e.g., https://your-backend.onrender.com)
REACT_APP_API_URL=http://localhost:5000
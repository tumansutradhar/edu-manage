# =========================================================================
# BACKEND ENVIRONMENT VARIABLES CONFIGURATION (EXAMPLE)
# Copy this file to a new file named '.env' and update the values below.
# =========================================================================

# Server Settings
NODE_ENV=development
PORT=5000

# MongoDB Connection String
# Replace with your local MongoDB URI or MongoDB Atlas Cloud URI
MONGODB_URI=mongodb+srv://<username>:<password>@your-cluster.mongodb.net/edumanage_db

# Security & Authentication Tokens
# Make sure to change 'your_super_secret_key' to a long, complex string in production
JWT_SECRET=your_super_secret_key_here_make_it_long_and_secure
JWT_EXPIRES_IN=7d

# Initial Admin User Seeding (used by running: npm run create-admin)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=SecureAdminPassword123!
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# Email SMTP Setup (Optional - for system notifications)
EMAIL_FROM=noreply@yourdomain.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_smtp_app_password

# File Upload Policies
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# CORS Authorized Origins
# Local Testing: http://localhost:3000
# Production: Change this to your live deployment URL (e.g., https://your-app.vercel.app)
CLIENT_URL=http://localhost:3000